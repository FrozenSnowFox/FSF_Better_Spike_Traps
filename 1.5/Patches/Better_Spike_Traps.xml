<?xml version="1.0" encoding="utf-8"?>

<Patch>

	<Operation Class="PatchOperationSequence">
		<success>Normal</success>
		<operations>
			
			<!-- Core -->

			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "TrapSpike"]/description</xpath>
				<value>
					<description>Five spikes under tension, connected to a touch-activated trigger. When the victim disturbs the trigger, the spikes spring forth and strike the victim. Animals can sense these when calm.</description>
				</value>
			</li>

			<li Class="PatchOperationRemove">
				<xpath>/Defs/ThingDef[defName = "TrapSpike"]/placeWorkers</xpath>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "TrapSpike"]/costStuffCount</xpath>
				<value>
					<costStuffCount>15</costStuffCount>
				</value>
			</li>
			
			<!-- Vanilla Furniture Expanded Security -->
			
			<li MayRequire="VanillaExpanded.VFESecurity" Class="PatchOperationRemove">
				<xpath>/Defs/ThingDef[defName = "VFES_BearTrap"]/placeWorkers</xpath>
			</li>
			
		</operations>
	</Operation>
	
</Patch>